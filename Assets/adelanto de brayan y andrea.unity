  dialogueManager: {fileID: 1625774773}
  dialogoFinalBueno:
  - nombrePersonaje: Pug
    texto: Felicidades manito, Dijo el pug antes de desaparecer.
    spritePersonaje: {fileID: 7908405407799206842, guid: fc44c4f8b1e84164a9822b133cbca6c8, type: 3}
  - nombrePersonaje: 
    texto: 'El codigo se creo correctamente y pudo entregar el codigo pasando con honores. '
    spritePersonaje: {fileID: 7985626363670038235, guid: e7c73d305bdd52643bb6db5551372eac, type: 3}
  dialogoFinalMalo:
  - nombrePersonaje: Pug
    texto: Perdon manito, te falto un poco mas de esfuerzo.
    spritePersonaje: {fileID: 7908405407799206842, guid: fc44c4f8b1e84164a9822b133cbca6c8, type: 3}
  - nombrePersonaje: 
    texto: Por suerte pudiste terminar tu tarea.
    spritePersonaje: {fileID: 7127568524274590195, guid: 084d9917fe5e9754ebd57371e9c7e6d9, type: 3}
  - nombrePersonaje: 
    texto: Lo malo es que gracias a tu programacion creaste una bomba casera.
    spritePersonaje: {fileID: -6376718673272750408, guid: 81bdf2880815a2941ab519d97a580124, type: 3}
  - nombrePersonaje: 
    texto: Felicitaciones.
    spritePersonaje: {fileID: -309459452766167434, guid: bda3526675812064eb2b0699eb9ddc68, type: 3}
