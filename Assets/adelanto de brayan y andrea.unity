--- !u!114 &1625774773
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1625774772}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 518f357d5a6da2d49bfaac42a3d07a79, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  dialogo:
  - nombrePersonaje: 
    texto: Durante el dia de un psyduck...
    spritePersonaje: {fileID: 0}
  - nombrePersonaje: 
    texto: "El peque\xF1o psyduck tenia que aprender a programar, pero el pobre no sabia."
    spritePersonaje: {fileID: -309459452766167434, guid: bda3526675812064eb2b0699eb9ddc68, type: 3}
  - nombrePersonaje: 
    texto: Trato, Trato y Trato y jamas lo logro...
    spritePersonaje: {fileID: 5628164624286106641, guid: 21f8028b140b818488948a85763d8190, type: 3}
  - nombrePersonaje: 
    texto: 'Hasta que se le ocurrio algo brillante.

'
    spritePersonaje: {fileID: -309459452766167434, guid: bda3526675812064eb2b0699eb9ddc68, type: 3}
  - nombrePersonaje: Psyduck
    texto: 'Si me concentro y lo pienso bien, hare que se resuelva solo. '
    spritePersonaje: {fileID: 43226203873635761, guid: 9bd12a5e0dcbd4a46988419b50504620, type: 3}
  - nombrePersonaje: 
    texto: Penso, Analizo y lo projecto...
    spritePersonaje: {fileID: 5002800166667262034, guid: 4af520ca3b81b7a4c9102d73ac163696, type: 3}
  - nombrePersonaje: 
    texto: 'Pero nada funciono...

'
    spritePersonaje: {fileID: 5628164624286106641, guid: 21f8028b140b818488948a85763d8190, type: 3}
  - nombrePersonaje: 
    texto: 'Hasta que se dio cuenta que habia empezado a alucinar.

'
    spritePersonaje: {fileID: -6376718673272750408, guid: 81bdf2880815a2941ab519d97a580124, type: 3}
  - nombrePersonaje: Pug
    texto: Quiubo manito, no te pases tantito, te ayudare con tu amarguito si juegas a mi jueguito.
    spritePersonaje: {fileID: 7908405407799206842, guid: fc44c4f8b1e84164a9822b133cbca6c8, type: 3}
  - nombrePersonaje: 
    texto: 'Psyduck acepto su destino...

'
    spritePersonaje: {fileID: -309459452766167434, guid: bda3526675812064eb2b0699eb9ddc68, type: 3}
